{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "rootDir": "${configDir}/src",
        "outDir": "${configDir}/dist"
    },
    "include": ["${configDir}/src/**/*.ts"],
    "exclude": ["${configDir}/src/**/*.spec.ts"]
}
